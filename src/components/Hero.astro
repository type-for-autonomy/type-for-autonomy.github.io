---
// Hero.astro
---
<section class="hero  global-height" aria-labelledby="hero-heading">
  <div class="hero__inner section-inner">
    <div class="hero__content">
      <div class="hero__logo">
        <img src="/assets/TYPE/Part 1/Logo Image.png" alt="" aria-hidden="true" />
      </div>
      <h1 class="hero__heading" id="hero-heading">TYPE</h1>
      <p class="hero__sub">Designed for growth.<br />Driven by you.</p>
      <a class="hero__cta btn" href="#mission" >Learn More</a>
    </div>
    <div class="hero__media" aria-hidden="true">
      <img src="/assets/TYPE/Part 1/illustration.gif" alt="" loading="eager" />
    </div>
  </div>
</section>

<style>  .hero {
    display: flex;
    align-items: center;
  }

  .hero__inner {
    display: flex;
    flex: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    gap: clamp(2rem, 3vw, 3.5rem);
    width: 100%;
  }

  .hero__content {
    display: grid;
    grid-template-areas: "logo" "heading" "sub" "cta";
    grid-template-columns: 1fr;
    grid-auto-rows: auto;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    }

  .hero__logo img {
    grid-area: logo;
    width: min(4rem, 8vw);
    height: auto;
    object-fit: contain;
  }
  .hero__heading {
    all: unset;
    grid-area: heading;
    font-family: var(--font-body);
    font-size: clamp(4.5rem, 10vw, 8rem);
    letter-spacing: -0.5rem;
    font-weight: 700;
    line-height: 0.9;
  }

  .hero__sub {
    grid-area: sub;
    color: var(--color-primary);
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    line-height: 1;
    font-family: var(--font-body);
    font-weight: 600;
  }

  .hero__cta {
    grid-area: cta;
    margin-top: clamp(1.5rem, 3vh, 2rem);
  }

  .hero__media {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .hero__media img {
    width: 100%;
    height: auto;
    object-fit: contain;
    max-width: 35rem;
  }

  /* Tablet: 48rem (768px) */
  @media (max-width: 48rem) {
    .hero__inner {
      flex-direction: column-reverse;
      justify-content: center;
      align-items: center;
      gap: clamp(1.5rem, 5vh, 3rem);
    }

    .hero__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: clamp(0.8rem, 2.5vh, 1.2rem);
    }

    .hero__logo img {
      display: none;
    }

    .hero__heading {
      font-size: clamp(5rem, 10vw, 7rem);
    }
    .hero__cta{
      max-width: none;
      margin-top: 1rem;
    }

    .hero__sub {
      font-size: clamp(2rem, 3.5vw, 4rem);
      max-width: 100%;
    }

    .hero__media {
      justify-content: center;
      /* flex: 1 0 auto; */
    }

    .hero__media img {
      width: clamp(25rem, 70vw, 35rem);
    }
  }

  /* Large Tablet / iPad Pro: 64rem (1024px) */
  @media (min-width: 49rem) and (max-width: 81rem) {
    .hero__inner {
      gap: clamp(2rem, 4vw, 3rem);
      flex-direction: row;
    }

    .hero__content {
      display: grid;
      gap: clamp(0.8rem, 2vh, 1.2rem);
      max-width: 28rem;
    }

    .hero__heading {
      font-size: clamp(4rem, 6vw, 5.5rem);
      letter-spacing: -0.3rem;
    }

    .hero__sub {
      font-size: clamp(1.4rem, 2vw, 1.8rem);
    }

    .hero__cta {
      margin-top: 1.2rem;
      max-width: 20rem;
    }

    .hero__media img {
      width: clamp(20rem, 50vw, 30rem);
    }
  }

  /* Mobile: 28rem (448px) */
  @media (max-width: 28rem) {
    .hero {
      padding: 0;
    }

    .hero__inner {
      justify-content: space-around;
      gap: 0.85rem;
      min-height: calc(100svh - var(--navbar-height));
      padding-block: 0.35rem 0.75rem;
    }

    .hero__content {
      gap: 0.35rem;
      align-items: center;
    }

    .hero__logo img {
      display: none;
    }

    .hero__heading {
      font-size: clamp(2.15rem, 10vw, 3rem);
      letter-spacing: 0;
    }

    .hero__sub {
      font-size: clamp(1rem, 4vw, 1.25rem);
      line-height: 1.05;
    }

    .hero__cta {
      max-width: none;
      margin-top: 0.55rem;
      min-height: 2.55rem;
      padding: 0.65rem 1.25rem;
      font-size: 0.9rem;
    }

    
  }
</style>
